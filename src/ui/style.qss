QMainWindow {
    background: #1E1E1E;
}
QMenuBar {
    background: #323233;
    color: #CCCCCC;
    border-bottom: 1px solid #3C3C3C;
    padding: 4px;
}
QMenuBar::item:selected {
    background: #094771;
    border-radius: 4px;
}
QMenu {
    background: #252526;
    color: #CCCCCC;
    border: 1px solid #333333;
}
QMenu::item:selected {
    background: #094771;
}

QTreeView {
    background: #252526;
    color: #D4D4D4;
    border: none;
    alternate-background-color: #2D2D2D;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
    font-size: 13px;
    outline: none;
}
QHeaderView::section {
    background: #323233;
    color: #CCCCCC;
    border: none;
    border-bottom: 1px solid #3C3C3C;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: normal;
}

QTreeView::item:hover {
    background: #2A2D2E;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: none;
}

QLineEdit {
    background: #3C3C3C;
    color: #D4D4D4;
    border: 1px solid #3C3C3C;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}
QLineEdit:focus {
    border-color: #007ACC;
}

QPushButton {
    background: #0E639C;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background: #1177BB;
}
QPushButton:pressed {
    background: #094771;
}

QStatusBar {
    background: #323233;
    color: #CCCCCC;
    border: none;
    font-size: 12px;
}

QScrollBar:vertical {
    background: #1E1E1E;
    width: 12px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #424242;
    border-radius: 6px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #4F4F4F;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1E1E1E;
    height: 12px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #424242;
    border-radius: 6px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #4F4F4F;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}