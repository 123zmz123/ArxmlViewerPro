QMainWindow {
    background: #2B2D30;
}
QMenuBar {
    background: #2B2D30;
    color: #A9B7C6;
    border-bottom: 1px solid #323232;
    padding: 4px;
}
QMenuBar::item:selected {
    background: #4B6EAF;
    border-radius: 4px;
}
QMenu {
    background: #2B2D30;
    color: #A9B7C6;
    border: 1px solid #323232;
}
QMenu::item:selected {
    background: #4B6EAF;
}

QTreeView {
    background: #1E1F22;
    color: #A9B7C6;
    border: none;
    alternate-background-color: #28292E;
    selection-background-color: #4B6EAF;
    selection-color: #FFFFFF;
    font-size: 13px;
    outline: none;
}
QHeaderView {
    background: #2B2D30;
}
QHeaderView::section {
    background: #2B2D30;
    color: #A9B7C6;
    border: none;
    border-bottom: 1px solid #323232;
    padding: 5px 10px;
    font-size: 12px;
    font-weight: normal;
}

QTreeView::item:hover {
    background: #323436;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
    image: none;
}

QLineEdit {
    background: #45494A;
    color: #A9B7C6;
    border: 1px solid #323232;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 13px;
}
QLineEdit:focus {
    border-color: #4B6EAF;
}

QPushButton {
    background: #4B6EAF;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-size: 13px;
}
QPushButton:hover {
    background: #5D82C1;
}
QPushButton:pressed {
    background: #3D5A8F;
}

QStatusBar {
    background: #2B2D30;
    color: #A9B7C6;
    border: none;
    font-size: 12px;
}

QScrollBar:vertical {
    background: #2B2D30;
    width: 8px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #4E5254;
    border-radius: 6px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #5E6264;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: #1E1F22;
    height: 8px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #4E5254;
    border-radius: 6px;
    min-width: 30px;
}
QScrollBar::handle:horizontal:hover {
    background: #5E6264;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}